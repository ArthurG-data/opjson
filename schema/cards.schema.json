{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/opjson/schema/cards.schema.json",
  "title": "opjson card file",
  "description": "data/cards/<prefix>.json: the cards whose number starts with <prefix>, each with every printing of it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards"],
  "properties": {
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "name", "category", "printings"],
        "properties": {
          "number": {"type": "string", "pattern": "^([A-Z]+[0-9]*-[0-9]{3}|DON)$"},
          "name": {"type": "string", "minLength": 1},
          "category": {"enum": ["Leader", "Character", "Event", "Stage", "DON"]},
          "cost": {"type": "integer", "minimum": 0},
          "power": {"type": "integer", "minimum": 0},
          "counter": {"type": "integer", "minimum": 0},
          "life": {"type": "integer", "minimum": 0},
          "attributes": {"$ref": "#/$defs/names"},
          "colors": {"type": "array", "uniqueItems": true, "items": {"enum": ["Red", "Green", "Blue", "Purple", "Black", "Yellow"]}},
          "types": {"$ref": "#/$defs/names"},
          "source": {"const": "tcgplayer", "description": "Present when Bandai's card list does not have the card (DON!!)."},
          "printings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/printing"}}
        }
      }
    }
  },
  "$defs": {
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "printing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "image", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^([A-Z]+[0-9]*-[0-9]{3}(_[pr][0-9]+)?|([A-Z]+[0-9]*-[0-9]{3}|DON)~tcg[0-9]+)$",
               "description": "Bandai's printing id (OP01-006_p1), or for a printing only TCGplayer sells, the card number and its TCGplayer product id (OP02-013~tcg485123)."},
        "set": {"type": "string"},
        "rarity": {"enum": ["L", "C", "UC", "R", "SR", "SEC", "SP CARD", "TR", "P", "SP", "DON!!"]},
        "cardSet": {"type": "string", "description": "What Bandai's card list gives as the printing's Card Set(s), e.g. \"CS 25-26 Top Player Pack\"."},
        "block": {"type": "string", "pattern": "^([0-9]+|X)$", "description": "The block icon printed on the card; X on cards exempt from block rotation."},
        "image": {"type": "string", "format": "uri"},
        "source": {"enum": ["bandai", "tcgplayer"]},
        "artOf": {"type": "string", "description": "The Bandai printing whose art this printing carries (a stamped or promo copy). The two share one illustration."},
        "artist": {"type": "string", "minLength": 1, "description": "The illustrator credited on the card. Neither source publishes it today; reserved for when one does."},
        "finishes": {"type": "array", "uniqueItems": true, "items": {"enum": ["nonfoil", "foil"]}},
        "treatments": {"type": "array", "uniqueItems": true, "items": {"enum": ["parallel", "alternate_art", "manga", "sp", "full_art", "wanted_poster", "reprint", "gold", "serial"]}},
        "promoTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "category"],
            "properties": {
              "type": {"type": "string", "pattern": "^[a-z_]+$"},
              "category": {"enum": ["foil-pattern", "event", "program", "retail", "championship", "placement", "anniversary", "media", "mark", "card-stock"]}
            }
          }
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tcgplayerProductIds": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"type": "integer"}},
            "cardkingdomId": {"type": "integer", "description": "Card Kingdom sells no One Piece today; reserved for when it does."}
          }
        },
        "tcgplayer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "match"],
          "description": "How the TCGplayer product was tied to this printing: by image ('image', 'image-only-candidate') or by minting a new printing ('minted'). distance is the image-hash distance in bits.",
          "properties": {
            "name": {"type": "string"},
            "match": {"enum": ["image", "image-only-candidate", "image+name", "image+cardset", "image+order", "whole-card", "image-other-set", "name", "minted", "reviewed"]},
            "distance": {"type": ["integer", "null"]}
          }
        }
      }
    }
  }
}
