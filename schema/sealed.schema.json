{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArthurG-data/opjson/schema/sealed.schema.json",
  "title": "opjson sealed file",
  "description": "data/sealed/<set>.json: the sealed products filed under one set.",
  "type": "object",
  "additionalProperties": false,
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "set", "category", "name", "contentsStatus", "contents", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "set": {"type": "string"},
          "category": {"enum": ["booster_pack", "sleeved_booster_pack", "booster_box", "case", "display", "double_pack",
                                "starter_deck", "ultra_deck", "premium_card_collection", "gift_collection", "tin",
                                "illustration_box", "collection", "promo_pack", "tournament_kit", "other"]},
          "name": {"type": "string", "minLength": 1},
          "releaseDate": {"type": "string", "format": "date"},
          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tcgplayerProductIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
              "cardkingdomId": {"type": "integer"}
            }
          },
          "contentsStatus": {"enum": ["complete", "partial", "unknown"],
                             "description": "complete: every item and count is stated. partial: what is listed is right, but counts or items are missing. unknown: nothing is stated."},
          "contents": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sealed": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["product"],
                         "properties": {"product": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}},
              "cards": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["printing"],
                        "properties": {"printing": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}}},
              "pool": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["set"],
                       "properties": {"set": {"type": "string"}}}}
            }
          },
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
        }
      }
    }
  }
}
